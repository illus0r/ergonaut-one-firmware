#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <500>; };

&mt {
    quick-tap-ms = <200>;
    flavor = "hold-preferred";
    tapping-term-ms = <2000>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <300>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Dedicated modifier chords on the base layer; letters have no hold-tap.
        // Keep each modifier pressed until BOTH chord keys have been released.
        shift_left {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <4 16>; // R + F
            timeout-ms = <50>;
            layers = <DEF>;
            slow-release;
        };
        shift_right {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <7 19>; // U + J
            timeout-ms = <50>;
            layers = <DEF>;
            slow-release;
        };

        ctrl_left {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <1 13>; // Q + A
            timeout-ms = <50>;
            layers = <DEF>;
            slow-release;
        };

        ctrl_right {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <10 22>; // P + ;
            timeout-ms = <50>;
            layers = <DEF>;
            slow-release;
        };

        alt_left {
            bindings = <&kp LEFT_ALT>;
            key-positions = <2 14>; // W + S
            timeout-ms = <50>;
            layers = <DEF>;
            slow-release;
        };

        alt_right {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <9 21>; // O + L
            timeout-ms = <50>;
            layers = <DEF>;
            slow-release;
        };

        cmd_left {
            bindings = <&kp LEFT_GUI>;
            key-positions = <3 15>; // E + D
            timeout-ms = <50>;
            layers = <DEF>;
            slow-release;
        };

        cmd_right {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <8 20>; // I + K
            timeout-ms = <50>;
            layers = <DEF>;
            slow-release;
        };

        // Original combos preserved unchanged.
        YU {
            bindings = <&kp LG(NUMBER_4)>;
            key-positions = <6 7>;
        };
        NM {
            bindings = <&none>;
            key-positions = <30 31>;
        };
        HJ {
            bindings = <&kp LC(SPACE)>;
            key-positions = <18 19>;
        };
        RT {
            bindings = <&kp LG(NUMBER_3)>;
            key-positions = <4 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE          &kp Q                &kp W            &kp E            &kp R              &kp T           &kp Y          &kp U               &kp I                 &kp O             &kp P                 &kp LBKT
&kp RIGHT_BRACKET  &kp A  &kp S  &kp D  &kp F  &kp G           &kp H          &kp J  &kp K  &kp L  &kp SEMICOLON  &kp SINGLE_QUOTE
&kp MINUS          &kp Z                &kp X            &kp C            &kp V              &kp B           &kp N          &kp M               &kp COMMA             &kp DOT           &kp FSLH              &kp BACKSLASH
                                                         &lt RSE TAB      &kp SPACE          &lt LWR ESCAPE  &lt LWR ENTER  &kp SPACE           &lt RSE BACKSPACE
            >;
        };

        lower_layer {
            bindings = <
&kp F1     &kp F2    &kp F3  &kp F4    &kp F5    &kp F6     &kp F7     &kp F8    &kp F9      &kp F10   &kp F11   &kp F12
&kp PLUS   &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp STAR    &kp LPAR  &kp RPAR  &kp MINUS
&kp EQUAL  &kp N1    &kp N2  &kp N3    &kp N4    &kp N5     &kp N6     &kp N7    &kp N8      &kp N9    &kp N0    &kp RALT
                             &trans    &trans    &trans     &trans     &trans    &kp DELETE
            >;
        };

        raise_layer {
            bindings = <
&none         &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &kp C_VOL_UP  &kp HOME  &kp PAGE_UP    &kp C_BRIGHTNESS_INC  &none           &kp K_SCROLL_UP
&kp KP_EQUAL  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &kp LEFT      &kp DOWN  &kp UP         &kp RIGHT             &kp LANGUAGE_1  &mt RCTRL K_APP
&none         &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &kp C_VOL_DN  &kp END   &kp PAGE_DOWN  &kp C_BRIGHTNESS_DEC  &kp LANGUAGE_2  &kp K_SCROLL_DOWN
                                          &trans     &trans     &trans        &trans        &trans    &trans
            >;
        };

        adjust_layer {
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &bootloader
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
&sys_reset   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &sys_reset
                                         &trans        &none         &trans        &none         &trans        &trans
            >;
        };
    };
};
